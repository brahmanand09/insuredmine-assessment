{
  "info": {
    "name": "InsuredMine Technical Assessment API",
    "description": "API collection for InsuredMine assessment featuring Task 1 (Worker thread XLSX upload, Policy search by username, Aggregated policy by user) and Task 2 (CPU monitor & Scheduled message post service).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Task 1 - Upload XLSX/CSV (Worker Threads)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "data-sheet - Node js Assesment (2) (1).xlsx"
            }
          ]
        },
        "url": {
          "raw": "http://localhost:3000/api/policies/upload",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "policies", "upload"]
        }
      }
    },
    {
      "name": "Task 1 - Search Policy Info by Username",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/policies/search?username=Lura Lucca",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "policies", "search"],
          "query": [
            {
              "key": "username",
              "value": "Lura Lucca"
            }
          ]
        }
      }
    },
    {
      "name": "Task 1 - Aggregated Policy by Each User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/policies/aggregated",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "policies", "aggregated"]
        }
      }
    },
    {
      "name": "Task 1 - Database Collections Overview",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/policies/overview",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "policies", "overview"]
        }
      }
    },
    {
      "name": "Task 2 - Real-time CPU Utilization Metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/system/cpu",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "system", "cpu"]
        }
      }
    },
    {
      "name": "Task 2 - Simulate CPU Spike >70%",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"durationMs\": 6000\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/system/simulate-cpu-spike",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "system", "simulate-cpu-spike"]
        }
      }
    },
    {
      "name": "Task 2 - Schedule Message Post Service",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Policy Renewal Reminder for Client\",\n  \"day\": \"tomorrow\",\n  \"time\": \"14:30\"\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/messages/schedule",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "messages", "schedule"]
        }
      }
    },
    {
      "name": "Task 2 - Get All Scheduled Messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/api/messages",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "messages"]
        }
      }
    }
  ]
}
