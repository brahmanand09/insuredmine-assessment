{
  "info": {
    "name": "InsuredMine Technical Assessment API",
    "description": "Postman API collection for InsuredMine assessment featuring Worker Thread XLSX Ingestion, Policy Search, User Aggregations, CPU Monitoring, and Atomic Message Scheduler.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Task 1 - Upload XLSX/CSV (Worker Threads)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/import",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "import"
          ]
        }
      }
    },
    {
      "name": "Task 1 - Search Policy Info by Username",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/policies/search?username=Lura",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "policies",
            "search"
          ],
          "query": [
            {
              "key": "username",
              "value": "Lura"
            }
          ]
        }
      }
    },
    {
      "name": "Task 1 - Aggregated Policies by Each User",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/policies/aggregate/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "policies",
            "aggregate",
            "users"
          ]
        }
      }
    },
    {
      "name": "Task 2 - Server Health & CPU Metrics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Task 2 - Schedule Message Post Service",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Policy Renewal Notification\",\n  \"day\": \"tomorrow\",\n  \"time\": \"14:30\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/messages/schedule",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages",
            "schedule"
          ]
        }
      }
    },
    {
      "name": "Task 2 - Get Scheduled Messages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/messages",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "messages"
          ]
        }
      }
    }
  ]
}
